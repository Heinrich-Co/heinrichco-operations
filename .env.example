# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google (service account for Sheets + Calendar sync)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# For Darwin → Gmail/Calendar actions (domain-wide delegation): the Workspace
# user to act as, e.g. camila@heinrichco-ai.com
GOOGLE_WORKSPACE_SUBJECT=

# Anthropic (Darwin + invoice capture)
ANTHROPIC_API_KEY=

# Google Sheet IDs
PAYABLES_SHEET_ID=
# Optional tab name for the Payables sheet (default "Payables")
PAYABLES_TAB=
# Presto Lead Intake sheet — synced to `leads` every 15 min via /api/sync/leads
LEAD_INTAKE_SHEET_ID=
# Optional tab name for the Lead Intake sheet (default "Lead Intake")
LEAD_INTAKE_TAB=
GA4_SHEET_ID=

# Cron protection (optional — Vercel sends this as a Bearer token)
CRON_SECRET=

# Web Push (optional — for push notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@heinrichco-ai.com
